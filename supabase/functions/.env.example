# Local Edge Function environment. Copy to supabase/functions/.env and fill in
# only the integrations you use. Never put these values in Vite .env.local.

SITE_URL=https://your-domain.example

LIQPAY_PUBLIC_KEY=sandbox_your-liqpay-public-key
LIQPAY_PRIVATE_KEY=sandbox_your-liqpay-private-key
LIQPAY_LIVE_PUBLIC_KEY=your-live-liqpay-public-key
LIQPAY_LIVE_PRIVATE_KEY=your-live-liqpay-private-key
LIQPAY_TEST_MODE=true

MONOBANK_TOKEN=your-live-monobank-acquiring-token
MONOBANK_TEST_TOKEN=your-test-monobank-acquiring-token

NOVA_POSHTA_API_KEY=your-nova-poshta-api-key

KYIVSTAR_CLIENT_ID=your-kyivstar-client-id
KYIVSTAR_CLIENT_SECRET=your-kyivstar-client-secret
KYIVSTAR_SMS_FROM=your-approved-sender-name
SMS_AUTH_HOOK_SECRET=v1,whsec_your-hook-secret
SMS_AUTH_MANAGEMENT_TOKEN=your-project-scoped-management-token

RESEND_API_KEY=re_your-resend-api-key
CRM_EMAIL_FROM="tatami.culture <mail@your-domain.example>"

# For local `supabase functions serve`, the CLI injects SUPABASE_URL and the
# project keys. Deployed functions always receive them from Supabase.
