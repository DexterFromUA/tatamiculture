# Set these as Supabase Edge Function secrets; never place them in Vite .env.local.
LIQPAY_PUBLIC_KEY=your-liqpay-public-key
LIQPAY_PRIVATE_KEY=your-liqpay-private-key
SITE_URL=https://your-domain.example
# Use sandbox_ keys and set this to true before testing. Remove this setting or
# set it to false before accepting real payments.
LIQPAY_TEST_MODE=true
