# tatami.culture environment variables
#
# Frontend variables belong in .env.local and in the frontend hosting settings.
# Only variables prefixed with VITE_ are exposed to the browser.

# Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Show the corresponding checkout and delivery integrations in the storefront.
# Enable a provider only after its Edge Functions and secrets are configured.
VITE_LIQPAY_ENABLED=false
VITE_MONOBANK_ENABLED=false
VITE_NOVAPOSHTA_ENABLED=true

# -----------------------------------------------------------------------------
# Custom Supabase Edge Function Secrets
# -----------------------------------------------------------------------------
# Set these in Supabase Dashboard -> Edge Functions -> Secrets, or with:
# supabase secrets set --env-file supabase/functions/.env
# Never add these server-side values to frontend hosting variables.

# Public storefront URL without a trailing slash. Used for payment return URLs.
SITE_URL=https://your-domain.example

# LiqPay sandbox/legacy pair and production pair.
LIQPAY_PUBLIC_KEY=sandbox_your-liqpay-public-key
LIQPAY_PRIVATE_KEY=sandbox_your-liqpay-private-key
LIQPAY_LIVE_PUBLIC_KEY=your-live-liqpay-public-key
LIQPAY_LIVE_PRIVATE_KEY=your-live-liqpay-private-key

# Compatibility fallback until the payment mode has been saved in CRM.
LIQPAY_TEST_MODE=true

# Monobank acquiring tokens. These are merchant acquiring tokens.
MONOBANK_TOKEN=your-live-monobank-acquiring-token
MONOBANK_TEST_TOKEN=your-test-monobank-acquiring-token

# Nova Poshta API 2.0 key used for directory lookup, TTN creation and tracking.
NOVA_POSHTA_API_KEY=your-nova-poshta-api-key

# Kyivstar Programmable SMS credentials and approved sender name.
KYIVSTAR_CLIENT_ID=your-kyivstar-client-id
KYIVSTAR_CLIENT_SECRET=your-kyivstar-client-secret
KYIVSTAR_SMS_FROM=your-approved-sender-name

# Supabase Send SMS Hook secret and a project-scoped Management API token.
# The hook secret format is v1,whsec_<base64>.
SMS_AUTH_HOOK_SECRET=v1,whsec_your-hook-secret
SMS_AUTH_MANAGEMENT_TOKEN=your-project-scoped-management-token

# -----------------------------------------------------------------------------
# Supabase-managed Edge Function variables
# -----------------------------------------------------------------------------
# Supabase injects these automatically in deployed Edge Functions. Do not add
# or override them in Dashboard secrets:
# SUPABASE_URL
# SUPABASE_ANON_KEY / SUPABASE_PUBLISHABLE_KEY
# SUPABASE_SERVICE_ROLE_KEY / SUPABASE_SECRET_KEY
#
# The project may also show managed names such as SUPABASE_DB_URL,
# SUPABASE_JWKS, SUPABASE_PUBLISHABLE_KEYS and SUPABASE_SECRET_KEYS. They are
# maintained by Supabase and do not need values in this file.
#
# Twilio credentials are configured in Supabase Authentication -> Phone and
# are not Edge Function environment variables used by this repository.
