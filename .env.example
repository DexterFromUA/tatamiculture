# Copy this file to .env.local and fill in values from Supabase Project Settings → API.
# Do not put the service_role key in a Vite application.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Set to true only after the liqpay-create-checkout and liqpay-webhook Edge
# Functions have been deployed and their secrets configured.
VITE_LIQPAY_ENABLED=false
LIQPAY_PUBLIC_KEY=your-liqpay-public-key
LIQPAY_PRIVATE_KEY=your-liqpay-private-key
SITE_URL=https://your-domain.example
# Use sandbox_ keys and set this to true before testing. Remove this setting or
# set it to false before accepting real payments.
LIQPAY_TEST_MODE=true
VITE_NOVAPOSHTA_ENABLED=true